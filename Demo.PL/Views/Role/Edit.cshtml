@model RoleviewModel
@{
    ViewData["Title"] = "Edit";
}

<h1> Edit</h1>
<br />
<br />



<form asp-action="Edit"  enctype="multipart/form-data"> 
        <partial name ="RolePartialView/_CreateEditPartialView" model="@Model"/>
        <a asp-action="AddOrRemoveUsers" asp-route-roleId="@Model.Id" class="btn btn-success">Add Or Remove User</a> 

      <input type="submit" value="Save Changes" class="btn btn-primary" />
    <a asp-action="Index" class="btn btn-light"style="background-color:green; border-color:green; color:white">Back To List</a>
</form>
@section ValidationScriptSection {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

