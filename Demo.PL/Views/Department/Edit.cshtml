@model DepartmentViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>
<br />
<br />

<form asp-action="Edit">
    <partial name ="DepartmentPartialView/_CreateEditPartialView"/>
    <input type="submit" value="Save Changes" class="btn btn-primary" />
    <a asp-controller="Department" asp-action="Index" class="btn btn-light" style="background-color:green; border-color:green; color:white">Back To List</a>
  
</form>
@section ValidationScriptSection {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

