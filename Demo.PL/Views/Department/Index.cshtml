@model IEnumerable<DepartmentViewModel>


@{
    ViewData["Title"] = "All Departments";
}
    <style>  
   
</style> 
<h1>All Departments</h1>
<br />
<br />
@if (TempData["Message"] != null)
{
            <div class ="alert alert-primary">
            <p>@TempData["Message"]</p>
        </div>
}
<div class=" row justify-content-center  align-items-center m-5">
    <form asp-action="Index" class="row col-8">
    <div class ="Col-8">
        <input type="text" class="form-control" name="SearchInput" id="SearchInput"  placeholder="Search By Name"/>
    </div>
     <div class ="Col-4">
        <input type="Submit"  value ="Search" class="btn btn-success" />
    </div>
</form>
</div>

<a asp-controller="Department" asp-action="Create" class="btn btn-primary">Create Department</a>
<br />
<br />

@if (Model.Count() > 0)
{
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(D => D.Code)</th>
                    <th>@Html.DisplayNameFor(D => D.Name)</th>
                    <th>@Html.DisplayNameFor(D => D.DateOfCreation)</th>
                    <th>Details</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var department in Model)
            {
                        <tr>
                            <td>@department.Code</td>
                            <td>@department.Name</td>
                            <td>@department.DateOfCreation</td>

                                    <partial name="_BottoPartialView" model="@department.Id.ToString()"/>
                           
                        </tr>
            }
            </tbody>
        </table>

}
else
{
        <div class="mt-4 alert alert-warning">
            <h4>There is No Department :(</h4>
        </div>
}

