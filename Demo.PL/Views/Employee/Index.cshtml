@model IEnumerable<EmployeeViewModel>


@{
    ViewData["Title"] = "All Employees";
    string ViewDataMessage = ViewData["Message"] as string; // Required Type Conversion 
    string ViewBagMessage = ViewBag.message; // not Required Type Conversion 
}

<h1>All Employees</h1>
<br />
<br />
@* <div class ="alert alert-primary">
    <p>@ViewData["Message"]</p>
</div> *@
@if (TempData["Message"] != null)
{
    <div class ="alert alert-primary">
    <p>@TempData["Message"]</p>
</div>}
@* <div class action="alert-primary">
    <p>@ViewBag.Message</p>
</div> *@
<div class=" row justify-content-center  align-items-center m-5">
    <form asp-action="Index" class="row col-8">
    <div class ="Col-8">
        <input type="text" class="form-control" name="SearchInput" id="SearchInput"  placeholder="Search By Name"/>
    </div>
     <div class ="Col-4">
        <input type="Submit"  value ="Search" class="btn btn-success" />
    </div>
</form>
</div>
<a asp-controller="Employee" asp-action="Create" class="btn btn-primary">Create Employee</a>
<br />
<br />

@if (Model.Count() > 0)
{
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(E => E.Image)</th>
                    <th>@Html.DisplayNameFor(E => E.Name)</th>
                    <th>@Html.DisplayNameFor(E => E.Age)</th>
                    <th>@Html.DisplayNameFor(E => E.Address)</th>
                    <th>@Html.DisplayNameFor(E => E.Department)</th>
                    <th>@Html.DisplayNameFor(E => E.Email)</th>
                    <th>@Html.DisplayNameFor(E => E.Salary)</th>
                    <th>@Html.DisplayNameFor(E => E.PhoneNumber)</th>
                    <th>@Html.DisplayNameFor(E => E.IsActive)</th>
                    <th>@Html.DisplayNameFor(E => E.IsDeleted)</th>
                    <th>@Html.DisplayNameFor(E => E.HireDate)</th>
                    <th>@Html.DisplayNameFor(E => E.DateOfCreation)</th>
                    
                    <th>Details</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var employee in Model)
            {
                        <tr>
                            <td>
                                <img src="~/files/images/@employee.ImageName" width="75" class ="img-fluid rounded-circle"/>
                            </td>
                            <td>@employee.Name</td>
                            <td>@employee.Age</td>
                            <td>@employee.Address</td>
                            <td>@employee?.Department?.Name</td>
                            <td>@employee.Email</td>
                            <td>@employee.Salary</td>
                            <td>@employee.PhoneNumber</td>
                            <td>@employee.IsActive</td>
                            <td>@employee.IsDeleted</td>
                            <td>@employee.HireDate</td>    
                            <td>@employee.DateOfCreation</td>

                                     <partial name="_BottoPartialView" model="@employee.Id.ToString()"/>

                            
                            
                       
                        </tr>
            }
            </tbody>
        </table>

}
else
{
        <div class="mt-4 alert alert-warning">
            <h4>There is No Employees :(</h4>
        </div>
}

